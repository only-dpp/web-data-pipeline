# Database
POSTGRES_DB=web_pipeline
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/web_pipeline

# Redis
REDIS_URL=redis://redis:6379/0

# Internal API
INTERNAL_API_KEY=change-this-in-production
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_DOCS=false

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
SMTP_MAX_RETRIES=2
EMAIL_FROM=your_email@gmail.com

# Digest delivery
DIGEST_TIMEZONE=America/Sao_Paulo
DIGEST_SEND_HOUR=9
DIGEST_SEND_MINUTE=0
DIGEST_LOOKBACK_HOURS=24
DIGEST_ITEMS_LIMIT=10
